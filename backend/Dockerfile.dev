FROM rust:1.85

WORKDIR /app

# Install cargo-watch for development
RUN cargo install cargo-watch

# Install dependencies for the application
RUN apt-get update && apt-get install -y \
    libssl-dev \
    pkg-config \
    default-mysql-client \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy Cargo.toml and Cargo.lock to cache dependencies
COPY Cargo.toml Cargo.lock* ./

# Create a dummy main.rs to build dependencies
RUN mkdir -p src && \
    echo "fn main() {println!(\"Dummy main\");}" > src/main.rs && \
    echo "pub fn dummy() {}" > src/db.rs && \
    echo "pub fn dummy() {}" > src/file.rs && \
    cargo build && \
    rm -rf src

# The actual source code will be mounted as a volume in docker-compose.yml
# This allows for hot-reloading during development

EXPOSE 8080

CMD ["cargo", "watch", "-x", "run"]
